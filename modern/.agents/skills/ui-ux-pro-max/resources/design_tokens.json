{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "colors": {
    "dark": {
      "background": "#09090b",
      "surface": "#18181b",
      "surfaceHover": "#27272a",
      "border": "#27272a",
      "textPrimary": "#fafafa",
      "textSecondary": "#a1a1aa",
      "accent": "#6366f1",
      "accentHover": "#4f46e5",
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444"
    },
    "light": {
      "background": "#ffffff",
      "surface": "#f4f4f5",
      "surfaceHover": "#e4e4e7",
      "border": "#e4e4e7",
      "textPrimary": "#09090b",
      "textSecondary": "#71717a",
      "accent": "#4f46e5",
      "accentHover": "#4338ca",
      "success": "#059669",
      "warning": "#d97706",
      "error": "#dc2626"
    }
  },
  "typography": {
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "scale": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px"
  },
  "radii": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
  }
}
