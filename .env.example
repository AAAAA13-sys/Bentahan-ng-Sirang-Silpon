# Silicon Trading PERN Stack Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# Default: Embedded PGlite stored at .data/postgres (zero installation required)
# For external PostgreSQL server, uncomment and set DATABASE_URL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/silicon_trading

# Better Auth Secret (Auto-generated if left blank in development)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:8090

# Optional: Next.js Frontend Direct Proxy
BACKEND_URL=http://127.0.0.1:5000
USE_EXPRESS_BACKEND=true
